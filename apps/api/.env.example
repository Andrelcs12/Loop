# Runtime (NestJS): use the Supavisor session pooler on port 5432.
DATABASE_URL=

# Migrations: use a direct connection or Supavisor session pooler on port 5432.
DIRECT_URL=

# Supabase Auth verification. This is a public/publishable key, never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

PORT=3000
CORS_ORIGINS=http://localhost:8081
